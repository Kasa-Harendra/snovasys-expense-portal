# Application Settings
PROJECT_NAME="Role-Based Expense Reimbursement Portal"
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1

# Security & JWT
SECRET_KEY=change-me-to-a-secure-random-secret-key-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Connection (PostgreSQL)
# Format: postgresql://username:password@localhost:5432/database_name
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/expense_portal

# CORS Allowed Origins (JSON array format)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]
