{
  "name": "balancevault-backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy || prisma db push",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "test:auth": "tsx tests/auth.test.ts",
    "test:onboarding": "tsx tests/onboarding.test.ts",
    "test:admin": "tsx tests/admin.test.ts",
    "test:browser": "tsx tests/e2e-browser.test.ts",
    "test:security": "tsx tests/security.test.ts",
    "test:all": "npm run test:auth && npm run test:onboarding && npm run test:admin && npm run test:security"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^5.19.1",
    "tsx": "^4.19.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.16.5",
    "puppeteer-core": "^25.17.0",
    "typescript": "^5.5.4"
  }
}
